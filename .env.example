# ---- Folders -------------------------------------------------------------
# Folder with your media files (images, videos, PDFs). Sub-folders are included.
MEDIA_DIR=./media
# Where the index (SQLite database + thumbnails) is stored.
DATA_DIR=./data

# ---- Dataset download (scripts/download_dataset.py only) -------------------
# Free key from https://pixabay.com/api/docs/  (leave empty to use Wikimedia only)
PIXABAY_API_KEY=

# ---- AI models (open-source, downloaded once on first run) -----------------
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
CAPTION_MODEL=Salesforce/blip-image-captioning-base
WHISPER_MODEL=tiny

# Turn these off for a much faster (but less accurate) index on slow machines
ENABLE_CAPTIONS=true
ENABLE_TRANSCRIPTION=true
ENABLE_OCR=true
CAPTION_BEAMS=3

# ---- Video sampling --------------------------------------------------------
VIDEO_FRAME_INTERVAL=4
VIDEO_MAX_FRAMES=16
VIDEO_MAX_CAPTIONS=6
VIDEO_SCENE_THRESHOLD=0.35
VIDEO_MAX_AUDIO_SEC=180

# ---- PDFs ------------------------------------------------------------------
PDF_MAX_PAGES_TEXT=60
PDF_MAX_PAGE_IMAGES=6

# ---- Reliability -----------------------------------------------------------
MAX_ATTEMPTS=3
MAX_FILE_MB=2048
# 0 = let PyTorch decide. Set e.g. 6 to leave CPU for other apps.
TORCH_THREADS=0

# ---- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
